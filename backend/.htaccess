# Apache Rewrite and Security Configuration
# Blueprint Section 2 & 11

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive config & database folders
    RewriteRule ^config/ - [F,L]
    RewriteRule ^database/ - [F,L]
    RewriteRule ^models/ - [F,L]
    RewriteRule ^controllers/ - [F,L]
    RewriteRule ^middleware/ - [F,L]
    RewriteRule ^helpers/ - [F,L]

    # Route all /api requests to api/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/(.*)$ api/index.php [QSA,L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
