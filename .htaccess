RewriteEngine On
RewriteBase /

# 1. Force HTTPS and www (Optional, recommended for consistency)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.aravmzpsports\.online$ [NC]
RewriteRule ^(.*)$ https://www.aravmzpsports.online/$1 [L,R=301]

# -------------------------------------------------------------
# 2. Map /api/* requests to /backend/api/*
# -------------------------------------------------------------
# Prevent infinite rewrite loops if already targeting backend
RewriteCond %{REQUEST_URI} !^/backend/api/ [NC]
# Rewrite /api or /api/<anything> to /backend/api/<anything>
RewriteRule ^api(?:/(.*))?$ backend/api/$1 [L,QSA]

# -------------------------------------------------------------
# 3. Map all other requests to /frontend/*
# -------------------------------------------------------------
# Exclude requests that already point inside /frontend or /backend
RewriteCond %{REQUEST_URI} !^/frontend/ [NC]
RewriteCond %{REQUEST_URI} !^/backend/ [NC]
# Exclude the /api route handled above
RewriteCond %{REQUEST_URI} !^/api(/.*)?$ [NC]
# Rewrite everything else to the frontend folder
RewriteRule ^(.*)$ frontend/$1 [L,QSA]